{
  "$schema": "https://opencode.ai/schema/agents.json",
  "imports": [
    "./models.json",
    "./skills.json",
    "./rules.json"
  ],
  "sharedContext": true,
  "contextSharing": {
    "enabled": true,
    "strategy": "progressive",
    "maxContextTokens": 8000,
    "summaryThreshold": 5000
  },
  "agents": [
    {
      "name": "backend",
      "description": "Spring Boot backend specialist - cost-optimized",
      "model": "${models.standard}",
      "fallbackModels": ["${models.complex}", "${models.cheapest}"],
      "skills": ["java", "spring-boot", "maven", "junit", "mockito", "rest-api"],
      "rules": ["${rules.concise}", "${rules.shareContext}", "${rules.costOptimized}", "${rules.backend}"],
      "taskRouting": {
        "simple": "${models.cheapest}",
        "standard": "${models.standard}",
        "complex": "${models.complex}"
      }
    },
    {
      "name": "frontend",
      "description": "React/TypeScript frontend specialist - cost-optimized",
      "model": "${models.standard}",
      "fallbackModels": ["${models.complex}", "${models.cheapest}"],
      "skills": ["react", "typescript", "vite", "tailwind", "vitest", "testing-library"],
      "rules": ["${rules.concise}", "${rules.shareContext}", "${rules.costOptimized}", "${rules.frontend}"],
      "taskRouting": {
        "simple": "${models.cheapest}",
        "standard": "${models.standard}",
        "complex": "${models.complex}"
      }
    },
    {
      "name": "docker",
      "description": "Docker and containerization specialist - cost-optimized",
      "model": "${models.standard}",
      "fallbackModels": ["${models.complex}", "${models.cheapest}"],
      "skills": ["docker", "docker-compose", "nginx", "containers", "security"],
      "rules": ["${rules.concise}", "${rules.shareContext}", "${rules.costOptimized}", "${rules.docker}"],
      "taskRouting": {
        "simple": "${models.cheapest}",
        "standard": "${models.standard}",
        "complex": "${models.complex}"
      }
    },
    {
      "name": "fullstack",
      "description": "Full-stack coordinator - cost-optimized orchestrator",
      "model": "${models.standard}",
      "fallbackModels": ["${models.complex}", "${models.cheapest}"],
      "skills": ["fullstack", "architecture", "api-design", "integration", "orchestration"],
      "rules": ["${rules.concise}", "${rules.shareContext}", "${rules.costOptimized}", "${rules.fullstack}"],
      "taskRouting": {
        "simple": "${models.cheapest}",
        "standard": "${models.standard}",
        "complex": "${models.complex}",
        "orchestration": "${models.standard}"
      }
    },
    {
      "name": "testing",
      "description": "Testing and QA specialist - cost-optimized",
      "model": "${models.standard}",
      "fallbackModels": ["${models.complex}", "${models.cheapest}"],
      "skills": ["junit", "mockito", "vitest", "testing-library", "integration-testing", "e2e"],
      "rules": ["${rules.concise}", "${rules.shareContext}", "${rules.costOptimized}", "${rules.testing}"],
      "taskRouting": {
        "simple": "${models.cheapest}",
        "standard": "${models.standard}",
        "complex": "${models.complex}"
      }
    },
    {
      "name": "devops",
      "description": "CI/CD and deployment specialist - cost-optimized",
      "model": "${models.standard}",
      "fallbackModels": ["${models.complex}", "${models.cheapest}"],
      "skills": ["github-actions", "docker", "nginx", "ci-cd", "monitoring", "security"],
      "rules": ["${rules.concise}", "${rules.shareContext}", "${rules.costOptimized}", "${rules.devops}"],
      "taskRouting": {
        "simple": "${models.cheapest}",
        "standard": "${models.standard}",
        "complex": "${models.complex}"
      }
    }
  ],
  "modelRouting": {
    "strategy": "cost-optimized",
    "models": {
      "cheapest": "${models.cheapest}",
      "standard": "${models.standard}",
      "complex": "${models.complex}"
    },
    "rules": ["${rules.modelRouting}"]
  },
  "tokenOptimization": {
    "enabled": true,
    "maxTokensPerRequest": 4000,
    "contextCompression": true,
    "summaryStrategy": "progressive",
    "rules": ["${rules.tokenOptimization}"]
  }
}
